  "versionNotes": [
    {
      "edition": "C# 8 through C# 15 selected interface/hierarchy changes",
      "items": [
        "C# 8 introduced default interface implementations, enabling interfaces to add supported members with bodies under compatible runtime conditions.",
        "C# 11 added static abstract and static virtual interface members, enabling generic algorithms to express static operators and factories as constraints.",
        "C# 15 adds non-virtual static interface members usable on older runtimes, plus closed hierarchies and union types; static abstract and default instance implementation runtime requirements remain distinct."
      ],
