  "versionNotes": [
    {
      "edition": ".NET 8 GA checked 2026-11-20",
      "items": [
        "Configuration binding source generation is available for supported intercepted call sites. Invalid array/list elements can be skipped and empty dictionary sections are materialized as default-valued entries; opt into ErrorOnUnknownConfiguration and validate resulting collection shape."
      ],
      "sourceUrls": [
        "https://learn.microsoft.com/en-us/dotnet/core/extensions/configuration-generator",
        "https://learn.microsoft.com/en-us/dotnet/core/compatibility/extensions/8.0/configurationbinder-skips-failed-array-elements",
        "https://learn.microsoft.com/en-us/dotnet/core/compatibility/extensions/8.0/dictionary-configuration-binding"
      ]
    },
    {
      "edition": ".NET 10 GA checked 2026-11-20",
      "items": [
        "JSON configuration nulls are preserved and bound distinctly from missing keys, including null array elements and empty arrays; null bound to non-nullable value types becomes default(T)."
      ],
      "sourceUrls": [
        "https://learn.microsoft.com/en-us/dotnet/core/compatibility/extensions/10.0/configuration-null-values-preserved"
      ]
    },
    {
      "edition": ".NET 11 GA checked 2026-11-20",
      "items": [
        "Options validation adds asynchronous validators/startup and async DataAnnotations APIs. IAsyncValidateOptions derives from IValidateOptions; synchronous paths that must recreate async-only options fail. Async startup may seed initial IOptions/IOptionsMonitor caches, but snapshots and monitor reload remain synchronous. IStartupValidator is obsolete.",
        "Configuration adds ConfigurationIgnoreAttribute and supports empty arrays for constructor parameters. AddConfiguration now treats chained empty strings as present values overriding earlier outer-provider values; null from the wrapped configuration remains indistinguishable from missing."
      ],
      "sourceUrls": [
        "https://learn.microsoft.com/en-us/dotnet/core/compatibility/extensions/11/async-options-validation-sync-access",
        "https://learn.microsoft.com/en-us/dotnet/core/whats-new/dotnet-11/libraries",
        "https://learn.microsoft.com/en-us/dotnet/core/compatibility/extensions/11/chained-configuration-empty-string",
        "https://learn.microsoft.com/en-us/dotnet/api/microsoft.extensions.options.istartupvalidator?view=net-11.0"
      ]
    }
  ],
