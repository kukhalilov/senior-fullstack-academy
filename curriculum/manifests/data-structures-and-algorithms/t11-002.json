  "practiceProblems": [
    {
      "id": "two-sum",
      "name": "Two Sum",
      "difficulty": "introductory",
      "patterns": [
        "complement lookup",
        "one-pass scan"
      ],
      "statement": "Given an integer array nums and an integer target, return the indices of the two numbers such that they add up to target. Assume exactly one solution exists and do not use the same element twice. Return the indices in any order.",
      "constraints": [
        "2 <= nums.Length <= 10^4",
        "-10^9 <= nums[i] <= 10^9",
        "-10^9 <= target <= 10^9",
        "Exactly one valid answer exists."
      ],
      "examples": [
        {
          "input": "nums = [2, 7, 11, 15], target = 9",
          "output": "[0, 1]"
        },
        {
          "input": "nums = [3, 2, 4], target = 6",
          "output": "[1, 2]"
        },
        {
          "input": "nums = [3, 3], target = 6",
          "output": "[0, 1]"
        }
      ],
      "sourceUrls": [
        "https://leetcode.com/problems/two-sum/description/"
      ]
    },
    {
      "id": "contains-duplicate",
      "name": "Contains Duplicate",
      "difficulty": "introductory",
      "patterns": [
        "membership tracking",
        "early exit"
      ],
      "statement": "Given an integer array nums, return true if any value appears at least twice in the array, and return false if every element is distinct.",
      "constraints": [
        "1 <= nums.Length <= 10^5",
        "-10^9 <= nums[i] <= 10^9"
      ],
      "examples": [
        {
          "input": "nums = [1, 2, 3, 1]",
          "output": "true"
        },
        {
          "input": "nums = [1, 2, 3, 4]",
          "output": "false"
        },
        {
          "input": "nums = [1, 1, 1, 3, 3, 4, 3, 2, 4, 2]",
          "output": "true"
        }
      ],
      "sourceUrls": [
        "https://leetcode.com/problems/contains-duplicate/description/",
        "https://learn.microsoft.com/en-us/dotnet/api/system.collections.generic.hashset-1.add?view=net-10.0",
        "https://learn.microsoft.com/en-us/dotnet/api/system.collections.generic.hashset-1?view=net-10.0"
      ]
    },
    {
      "id": "stock-one-transaction",
      "name": "Best Time to Buy and Sell Stock",
      "difficulty": "introductory",
      "patterns": [
        "running minimum",
        "single pass"
      ],
      "statement": "Given an integer array prices where prices[i] is the stock price on day i, choose one day to buy and a different later day to sell. Return the maximum profit; return 0 if no profitable transaction is possible.",
      "constraints": [
        "1 <= prices.Length <= 10^5",
        "0 <= prices[i] <= 10^4",
        "The buy day must be strictly earlier than the sell day."
      ],
      "examples": [
        {
          "input": "prices = [7,1,5,3,6,4]",
          "output": "5"
        },
        {
          "input": "prices = [7,6,4,3,1]",
          "output": "0"
        }
      ],
      "sourceUrls": [
        "https://leetcode.com/problems/best-time-to-buy-and-sell-stock/description/"
      ]
    },
    {
      "id": "maximum-subarray",
      "name": "Maximum Subarray",
      "difficulty": "intermediate",
      "patterns": [
        "running best",
        "Kadane recurrence",
        "contiguous subarray",
        "all-negative input"
      ],
      "statement": "Given an integer array nums, find the subarray with the largest sum, and return its sum. A subarray is a non-empty contiguous sequence of elements.",
      "constraints": [
        "1 <= nums.Length <= 10^5",
        "-10^4 <= nums[i] <= 10^4"
      ],
      "examples": [
        {
          "input": "nums = [-2,1,-3,4,-1,2,1,-5,4]",
          "output": "6"
        },
        {
          "input": "nums = [1]",
          "output": "1"
        },
        {
          "input": "nums = [5,4,-1,7,8]",
          "output": "23"
        }
      ],
      "sourceUrls": [
        "https://leetcode.com/problems/maximum-subarray/description/"
      ]
    },
    {
      "id": "product-except-self",
      "name": "Product of Array Except Self",
      "difficulty": "intermediate",
      "patterns": [
        "prefix products",
        "suffix products",
        "no division",
        "output array as workspace"
      ],
      "statement": "Given an integer array nums, return an array answer such that answer[i] is equal to the product of all the elements of nums except nums[i]. Do not use division and run in O(n) time.",
      "constraints": [
        "2 <= nums.Length <= 10^5",
        "-30 <= nums[i] <= 30",
        "Every prefix or suffix product of nums fits in a signed 32-bit integer.",
        "Every answer[i] fits in a signed 32-bit integer."
      ],
      "examples": [
        {
          "input": "nums = [1,2,3,4]",
          "output": "[24,12,8,6]"
        },
        {
          "input": "nums = [-1,1,0,-3,3]",
          "output": "[0,0,9,0,0]"
        }
      ],
      "sourceUrls": [
        "https://leetcode.com/problems/product-of-array-except-self/"
      ]
    },
    {
      "id": "move-zeroes",
      "name": "Move Zeroes",
      "difficulty": "introductory",
      "patterns": [
        "write pointer",
        "stable in-place compaction",
        "minimum swaps"
      ],
      "statement": "Given an integer array nums, move all zero values to the end while maintaining the relative order of the non-zero values. Modify nums in place without making a copy of the array.",
      "constraints": [
        "1 <= nums.Length <= 10^4",
        "-2^31 <= nums[i] <= 2^31 - 1"
      ],
      "examples": [
        {
          "input": "nums = [0,1,0,3,12]",
          "output": "[1,3,12,0,0]"
        },
        {
          "input": "nums = [0]",
          "output": "[0]"
        }
      ],
      "sourceUrls": [
        "https://leetcode.com/problems/move-zeroes/"
      ]
    },
    {
      "id": "rotate-array",
      "name": "Rotate Array",
      "difficulty": "intermediate",
      "patterns": [
        "modular index",
        "in-place reversal"
      ],
      "statement": "Given an integer array nums, rotate the array to the right by k steps, where k is non-negative. Perform the operation in-place.",
      "constraints": [
        "1 <= nums.Length <= 10^5",
        "-2^31 <= nums[i] <= 2^31 - 1",
        "0 <= k <= 10^5"
      ],
      "examples": [
        {
          "input": "nums = [1, 2, 3, 4, 5, 6, 7], k = 3",
          "output": "[5, 6, 7, 1, 2, 3, 4]"
        },
        {
          "input": "nums = [-1, -100, 3, 99], k = 2",
          "output": "[3, 99, -1, -100]"
        }
      ],
      "sourceUrls": [
        "https://leetcode.com/problems/rotate-array/description/"
      ]
    }
